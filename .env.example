# ===========================================
# MCI Donaciones Frontend - Environment Variables
# ===========================================
# Copy this file to .env.local for development
# In Amplify: Add these in Environment Variables section

# API Backend URL (required for production)
# Development uses Vite proxy (VITE_PROXY_TARGET), so this is only needed for production/staging
VITE_API_BASE_URL=https://tu-api.mcisabananorte.org/api

# Example values:
# - Production:  https://api.mcisabananorte.org/api
# - Staging:     https://staging-api.mcisabananorte.org/api

# Proxy target for Vite dev server (LOCAL ONLY — copy to .env.local, never deploy this)
# Points to the Laravel backend running locally
VITE_PROXY_TARGET=http://localhost:8500

# Example values:
# - php artisan serve:  http://localhost:8500
# - MAMP Pro:           http://mci-sabana-norte.dashboard:8888
