# ===========================================
# MCI Donaciones Frontend - Environment Variables
# ===========================================
# Copy this file to .env.local for development
# In Amplify: Add these in Environment Variables section

# API Backend URL (required for production)
# Development uses Vite proxy, so this is only needed for production
VITE_API_BASE_URL=https://tu-api.mcisabananorte.org/api

# Example values:
# - Production: https://api.mcisabananorte.org/api
# - Staging: https://staging-api.mcisabananorte.org/api
